{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/quem-somos",
      "destination": "/sobre/",
      "permanent": true
    },
    {
      "source": "/galeria-de-fotos",
      "destination": "/sobre/",
      "permanent": true
    },
    {
      "source": "/produtos",
      "destination": "/sobre/",
      "permanent": false
    },
    {
      "source": "/congelados/:splat*",
      "destination": "/sobre/",
      "permanent": false
    },
    {
      "source": "/frutas/:splat*",
      "destination": "/sobre/",
      "permanent": false
    },
    {
      "source": "/produtos-in-natura/:splat*",
      "destination": "/sobre/",
      "permanent": false
    },
    {
      "source": "/loja/:splat*",
      "destination": "/sobre/",
      "permanent": false
    },
    {
      "source": "/carrinho/:splat*",
      "destination": "/sobre/",
      "permanent": false
    },
    {
      "source": "/fale-conosco",
      "destination": "/contato/",
      "permanent": true
    }
  ]
}
